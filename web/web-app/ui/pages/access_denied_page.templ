package pages

import (
	"github.com/GoEnterpricePlatform/goEP-core/web/web-app/ui/layouts"
)

templ AccessDeniedPage() {
	@layouts.BaseLayout("access denied", AccessDeniedContent())
}

templ AccessDeniedContent() {
	<section class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
		<div class="flex min-h-[80vh] items-center justify-center">
			<div class="w-full max-w-md">
				<p class="text-sm font-medium uppercase tracking-wider text-zinc-500">
					Access denied
				</p>

				<div class="mt-6 flex flex-col gap-3">
					<a
						href="/"
						class="w-full rounded-lg border border-zinc-300 px-4 py-2.5 text-center text-sm font-semibold text-zinc-700 transition-colors hover:bg-zinc-100"
					>
						Back to home
					</a>

					<a
						href="/v1/goep-admin/auth/sign-in"
						class="w-full rounded-lg bg-black px-4 py-2.5 text-center text-sm font-semibold text-white transition-colors hover:bg-zinc-800"
					>
						Sign in
					</a>
				</div>
			</div>
		</div>
	</section>
}