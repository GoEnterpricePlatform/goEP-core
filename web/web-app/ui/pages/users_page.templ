package pages

import (
	"github.com/GoEnterpricePlatform/goEP-core/web/web-app/ui/layouts"
	"github.com/GoEnterpricePlatform/goEP-core/pkg/identity/tokens/claim"
)

templ UsersPage(claims *claim.AccessTokenClaims) {
	@layouts.DashboardLayout(
		"users",
		claims.Roles,
		claims.Permissions,
		UsersContent(),
	)
}

templ UsersContent() {
	<section>

		<div class="mb-6">
			<h1 class="text-2xl font-bold tracking-tight text-black">
				Users
			</h1>

			<p class="mt-1 text-sm text-zinc-500">
				Welcome to your dashboard.
			</p>
		</div>

		<div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">

			<div class="rounded-xl border border-zinc-200 bg-white p-5">
				<p class="text-sm text-zinc-500">Users</p>
				<p class="mt-2 text-2xl font-bold">120</p>
			</div>

			<div class="rounded-xl border border-zinc-200 bg-white p-5">
				<p class="text-sm text-zinc-500">Posts</p>
				<p class="mt-2 text-2xl font-bold">48</p>
			</div>

		</div>

	</section>
}