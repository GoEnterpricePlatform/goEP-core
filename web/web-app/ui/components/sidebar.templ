package components

templ Sidebar(activePage string) {
	<aside class="hidden w-64 shrink-0 border-r border-zinc-200 bg-white md:block">

		<div class="flex h-16 items-center border-b border-zinc-200 px-6">
			<a
				href="/v1/goep-admin/general"
				class="text-lg font-bold tracking-tight text-black"
			>
				GoEP
			</a>
		</div>

		<nav class="p-4">

			<a
				href="/v1/goep-admin/general"
				class={ "mb-1 flex items-center rounded-lg px-3 py-2 text-sm font-medium transition-colors " + activeClass(activePage, "general") }
			>
				General
			</a>

			<a
				href="/v1/goep-admin/users"
				class={ "mb-1 flex items-center rounded-lg px-3 py-2 text-sm font-medium transition-colors " + activeClass(activePage, "users") }
			>
				Users
			</a>

			<a
				href="/v1/goep-admin/roles-permissions"
				class={ "mb-1 flex items-center rounded-lg px-3 py-2 text-sm font-medium transition-colors " + activeClass(activePage, "roles-permissions") }
			>
				Roles and permissions
			</a>

			<a
				href="/v1/goep-admin/settings"
				class={ "mb-1 flex items-center rounded-lg px-3 py-2 text-sm font-medium transition-colors " + activeClass(activePage, "settings") }
			>
				Settings
			</a>

		</nav>

	</aside>
}