package components

func activeClass(activePage string, page string) string {
	if activePage == page {
		return "bg-black text-white"
	}

	return "text-zinc-600 hover:bg-zinc-100 hover:text-black"
}

templ Header(activePage string) {
	<header class="sticky top-0 z-50 border-b border-zinc-200 bg-white/95 backdrop-blur">

		<div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6 lg:px-8">

			<a
				href="/"
				class="text-lg font-bold tracking-tight text-black transition-opacity hover:opacity-70"
			>
				GoTemplates
			</a>

			<nav class="flex items-center gap-1">

				<a
					href="/landing"
					class={ "rounded-lg px-3 py-2 text-sm font-medium transition-colors " + activeClass(activePage, "landing") }
				>
					Landing
				</a>

				<a
					href="/about_us"
					class={ "rounded-lg px-3 py-2 text-sm font-medium transition-colors " + activeClass(activePage, "about_us") }
				>
					About Us
				</a>

				<a
					href="/blog"
					class={ "rounded-lg px-3 py-2 text-sm font-medium transition-colors " + activeClass(activePage, "blog") }
				>
					Blog
				</a>

				<a
					href="/contact"
					class={ "rounded-lg px-3 py-2 text-sm font-medium transition-colors " + activeClass(activePage, "contact") }
				>
					Contact
				</a>

			</nav>

		</div>

	</header>
}