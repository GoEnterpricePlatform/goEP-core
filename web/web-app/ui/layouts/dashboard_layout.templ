// web/web-app/ui/layouts/dashboard.templ

package layouts

import (
	"github.com/GoEnterpricePlatform/goEP-core/web/web-app/ui/components"
)

templ DashboardLayout(
	activePage string,
	roles []string,
	permissions []string,
	content templ.Component,
) {
	@BaseLayout(
		activePage,
		DashboardLayoutContent(activePage, roles, permissions, content),
	)
}

templ DashboardLayoutContent(
	activePage string,
	roles []string,
	permissions []string,
	content templ.Component,
) {
	<div class="flex min-h-screen">

		@components.Sidebar(activePage, roles, permissions)

		<div class="flex min-w-0 flex-1 flex-col">

			@components.DashboardHeader()

			<main class="flex-1 p-6">
				@content
			</main>

		</div>

	</div>
}