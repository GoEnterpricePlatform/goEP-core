package layouts

import (
	"github.com/GoEnterpricePlatform/goEP-core/web/web-app/ui/components"
	"github.com/GoEnterpricePlatform/goEP-core/web/web-app/resources"
)

templ Base(activePage string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="icon" type="image/x-icon" href={ resources.StaticPath("assets/favicon.ico") }/>
			
			<title>Mi app</title>

			<style>
				body {
					margin: 0;
					font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
					background-color: #f9fafb;
					color: #1f2937;
				}

				.layout {
					display: grid;
					min-height: 100dvh;
					grid-template-rows: auto 1fr auto;
				}

				main {
					max-width: 100%;
					margin: 10px;
					padding: 0;
				}
			</style>
		</head>

		<body>
			<div class="layout">
				@components.Header(activePage)

				<main>
					@content
				</main>

				@components.Footer(2026)
			</div>

			/* <script src={ resources.StaticPath("js/hello-world.js") }></script> */
		</body>
	</html>
}