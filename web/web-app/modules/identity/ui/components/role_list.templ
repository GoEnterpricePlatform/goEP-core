package components

import (
	"github.com/GoEnterpricePlatform/goEP-core/addons/identity/roles/domain"
)

templ RoleList(roles []*domain.Role) {
	<div id="role-list" class="w-full">
		<div class="overflow-hidden rounded-xl border border-zinc-200 bg-white">
			<div class="overflow-x-auto">
				<table class="w-full text-left text-sm">
					<thead class="border-b border-zinc-200 bg-zinc-50">
						<tr>
							<th class="px-5 py-3 text-xs font-semibold uppercase tracking-wide text-zinc-500">
								ID
							</th>

							<th class="px-5 py-3 text-xs font-semibold uppercase tracking-wide text-zinc-500">
								Nombre
							</th>

							<th class="px-5 py-3 text-right text-xs font-semibold uppercase tracking-wide text-zinc-500">
								Acciones
							</th>
						</tr>
					</thead>

					<tbody id="role-list-body" class="divide-y divide-zinc-200">
						for _, role := range roles {
							@RoleRow(role)
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}