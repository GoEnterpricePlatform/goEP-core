package components

templ ConfirmPasswordField() {
    <div>
	    <label for="confirm_password" class="block text-sm font-medium text-zinc-700">
	    	Confirm password
	    </label>
	    <input
	    	id="confirm_password"
	    	name="confirm_password"
	    	type="password"
	    	data-bind:confirm_password
	    	class="mt-1 block w-full rounded-lg border border-zinc-300 px-4 py-2.5 text-sm outline-none transition-colors"
	    	data-attr:class="
	    		`mt-1 block w-full rounded-lg border px-4 py-2.5 text-sm outline-none transition-colors ${
	    			$submitted
	    				? (
	    					validationController.isValidPassword($confirm_password)
	    					&& $confirm_password == $password
	    						? 'border-green-500'
	    						: 'border-red-500'
	    				)
	    				: 'border-zinc-300'
	    		}`
	    	"
	    />
	    <div
	    	class="hidden mt-1 text-sm text-red-500"
	    	data-style:display="$submitted && (!validationController.isValidPassword($confirm_password) || $confirm_password != $password) ? 'block' : 'none'"
	    >
	    	<span
	    		data-style:display="$confirm_password == '' ? 'inline' : 'none'"
	    	>
	    		Confirm password is required
	    	</span>
	    	<span
	    		data-style:display="$confirm_password != '' && $confirm_password.length < 8 ? 'inline' : 'none'"
	    	>
	    		Confirm password must be at least 8 characters
	    	</span>
	    	<span
	    		data-style:display="$confirm_password != '' && $confirm_password.length >= 8 && !/[A-Z]/.test($confirm_password) ? 'inline' : 'none'"
	    	>
	    		Confirm password must contain at least one uppercase letter
	    	</span>
	    	<span
	    		data-style:display="$confirm_password != '' && $confirm_password.length >= 8 && !/[a-z]/.test($confirm_password) ? 'inline' : 'none'"
	    	>
	    		Confirm password must contain at least one lowercase letter
	    	</span>
	    	<span
	    		data-style:display="$confirm_password != '' && $confirm_password.length >= 8 && !/[0-9]/.test($confirm_password) ? 'inline' : 'none'"
	    	>
	    		Confirm password must contain at least one number
	    	</span>
	    	<span
	    		data-style:display="$confirm_password != '' && validationController.isValidPassword($confirm_password) && $confirm_password != $password ? 'inline' : 'none'"
	    	>
	    		Passwords do not match
	    	</span>
		</div>
	</div>
}