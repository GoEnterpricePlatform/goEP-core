package pages

import (
	"github.com/GoEnterpricePlatform/goEP-core/web/web-app/ui/layouts"
	"github.com/GoEnterpricePlatform/goEP-core/web/web-app/modules/identity/ui/components"
	"github.com/GoEnterpricePlatform/goEP-core/web/web-app/resources"
)

templ AdminSignUpPage() {
	// first we load the validation functions, then we load datastar with BaseLayout so it can find them
	// they are small functions that make the UI interactive 
	<script
		type="module"
		src={ resources.StaticPath("js/modules/identity/validations/index.js") }
	></script>
	@layouts.BaseLayout("admin sign up", AdminSignUpContent())
}

templ AdminSignUpContent() {
	<section class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
		<div class="flex min-h-[80vh] items-center justify-center">
			<div class="w-full max-w-md">
				<p class="text-sm font-medium uppercase tracking-wider text-zinc-500">
					Admin Sign up
				</p>

				<h1 class="mt-2 text-4xl font-bold tracking-tight text-black">
					Create your admin account
				</h1>

				<p class="mt-3 text-lg leading-8 text-zinc-600">
					Enter your credentials to continue
				</p>

				<form
					class="mt-8 space-y-5"
					data-signals="{
						submitted: false,
						email: '',
						password: '',
						confirm_password: '',
						error: '',
					}"
					data-on:submit__prevent="
						$submitted = true;
						if (
						    !validationController.isFormValidSignUp($email,$password,$confirm_password)
						) {
						    return;
						}
						@post('/v1/admin/auth/sign-up', {contentType: 'form'})
					"
					enctype="multipart/form-data"
				>
					@components.EmailField()
					@components.PasswordFieldSignUp()
					@components.ConfirmPasswordField()
	
					
					<div
					    class="hidden mb-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600"
					    data-style:display="$error != '' ? 'block' : 'none'"
					>
					    <span data-text="$error"></span>
					</div>

					<button
						type="submit"
						class="w-full rounded-lg bg-black px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-zinc-800"
					>
						Sign up
					</button>

					// field status in real time
					@components.FormStateSignUp()
					
				</form>
			</div>
		</div>
	</section>
}
	