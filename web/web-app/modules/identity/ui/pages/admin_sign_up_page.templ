package pages

import (
	"github.com/GoEnterpricePlatform/goEP-core/web/web-app/ui/layouts"
	"github.com/GoEnterpricePlatform/goEP-core/web/web-app/resources"
)

templ AdminSignUpPage() {
	// first we load the validation functions, then we load datastar with BaseLayout so it can find them
	// they are small functions that make the UI interactive 
	<script
		type="module"
		src={ resources.StaticPath("js/modules/identity/validations/index.js") }
	></script>
	@layouts.BaseLayout("admin sign up", AdminSignUpContent())
}

templ AdminSignUpContent() {
	<section class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
		<div class="flex min-h-[80vh] items-center justify-center">
			<div class="w-full max-w-md">
				<p class="text-sm font-medium uppercase tracking-wider text-zinc-500">
					Admin Sign up
				</p>

				<h1 class="mt-2 text-4xl font-bold tracking-tight text-black">
					Create your admin account
				</h1>

				<p class="mt-3 text-lg leading-8 text-zinc-600">
					Enter your credentials to continue
				</p>

				<form
					class="mt-8 space-y-5"
					data-signals="{
						submitted: false,
						email: '',
						password: '',
						confirm_password: '',
						error: '',
					}"
					data-on:submit__prevent="
						$submitted = true;
						if (
						    !validationController.isFormValidSignUp($email,$password,$confirm_password)
						) {
						    return;
						}
						@post('/v1/admin/auth/sign-up', {contentType: 'form'})
					"
					enctype="multipart/form-data"
				>
					<div>
						<label for="email" class="block text-sm font-medium text-zinc-700">
							Email
						</label>
						<input
							id="email"
							name="email"
							type="text"
							data-bind:email
							class="mt-1 block w-full rounded-lg border border-zinc-300 px-4 py-2.5 text-sm outline-none transition-colors"
							data-attr:class="`
								mt-1 block w-full rounded-lg border px-4 py-2.5 text-sm outline-none transition-colors
								${$submitted
									? (validationController.isValidEmail($email) ? 'border-green-500' : 'border-red-500')
									: 'border-zinc-300'
								}
							`"
						/>
						<div
							class="hidden mt-1 text-sm text-red-500"
							data-attr:class="
								$submitted && !validationController.isValidEmail($email)
									? 'mt-1 text-sm text-red-500'
									: 'hidden'
							"
						>
							<span
								data-attr:class="
									$email == ''
										? 'inline'
										: 'hidden'
								"
							>
								Email is required
							</span>

							<span
								data-attr:class="
									$email != '' && !validationController.isValidEmail($email)
										? 'inline'
										: 'hidden'
								"
							>
								Enter a valid email
							</span>
						</div>
					</div>
					<div>
						<label for="password" class="block text-sm font-medium text-zinc-700">
							Password
						</label>

						<input
							id="password"
							name="password"
							type="password"
							data-bind:password
							class="mt-1 block w-full rounded-lg border border-zinc-300 px-4 py-2.5 text-sm outline-none transition-colors"
							data-attr:class="
								`mt-1 block w-full rounded-lg border px-4 py-2.5 text-sm outline-none transition-colors ${
									$submitted
										? (validationController.isValidPassword($password)
											? 'border-green-500'
											: 'border-red-500')
										: 'border-zinc-300'
								}`
							"
						/>

						<div
							class="hidden mt-1 text-sm text-red-500"
							data-style:display="$submitted && !validationController.isValidPassword($password) ? 'block' : 'none'"
						>
							<span
								data-style:display="$password == '' ? 'inline' : 'none'"
							>
								Password is required
							</span>

							<span
								data-style:display="$password != '' && $password.length < 8 ? 'inline' : 'none'"
							>
								Password must be at least 8 characters
							</span>

							<span
								data-style:display="$password != '' && $password.length >= 8 && !/[A-Z]/.test($password) ? 'inline' : 'none'"
							>
								Password must contain at least one uppercase letter
							</span>

							<span
								data-style:display="$password != '' && $password.length >= 8 && !/[a-z]/.test($password) ? 'inline' : 'none'"
							>
								Password must contain at least one lowercase letter
							</span>

							<span
								data-style:display="$password != '' && $password.length >= 8 && !/[0-9]/.test($password) ? 'inline' : 'none'"
							>
								Password must contain at least one number
							</span>
						</div>
					</div>

					<div>
						<label for="confirm_password" class="block text-sm font-medium text-zinc-700">
							Confirm password
						</label>

						<input
							id="confirm_password"
							name="confirm_password"
							type="password"
							data-bind:confirm_password
							class="mt-1 block w-full rounded-lg border border-zinc-300 px-4 py-2.5 text-sm outline-none transition-colors"
							data-attr:class="
								`mt-1 block w-full rounded-lg border px-4 py-2.5 text-sm outline-none transition-colors ${
									$submitted
										? (
											validationController.isValidPassword($confirm_password)
											&& $confirm_password == $password
												? 'border-green-500'
												: 'border-red-500'
										)
										: 'border-zinc-300'
								}`
							"
						/>

						<div
							class="hidden mt-1 text-sm text-red-500"
							data-style:display="$submitted && (!validationController.isValidPassword($confirm_password) || $confirm_password != $password) ? 'block' : 'none'"
						>
							<span
								data-style:display="$confirm_password == '' ? 'inline' : 'none'"
							>
								Confirm password is required
							</span>

							<span
								data-style:display="$confirm_password != '' && $confirm_password.length < 8 ? 'inline' : 'none'"
							>
								Confirm password must be at least 8 characters
							</span>

							<span
								data-style:display="$confirm_password != '' && $confirm_password.length >= 8 && !/[A-Z]/.test($confirm_password) ? 'inline' : 'none'"
							>
								Confirm password must contain at least one uppercase letter
							</span>

							<span
								data-style:display="$confirm_password != '' && $confirm_password.length >= 8 && !/[a-z]/.test($confirm_password) ? 'inline' : 'none'"
							>
								Confirm password must contain at least one lowercase letter
							</span>

							<span
								data-style:display="$confirm_password != '' && $confirm_password.length >= 8 && !/[0-9]/.test($confirm_password) ? 'inline' : 'none'"
							>
								Confirm password must contain at least one number
							</span>

							<span
								data-style:display="$confirm_password != '' && validationController.isValidPassword($confirm_password) && $confirm_password != $password ? 'inline' : 'none'"
							>
								Passwords do not match
							</span>
						</div>
					</div>

					<div
					    class="hidden mb-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600"
					    data-style:display="$error != '' ? 'block' : 'none'"
					>
					    <span data-text="$error"></span>
					</div>

					<button
						type="submit"
						class="w-full rounded-lg bg-black px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-zinc-800"
					>
						Sign up
					</button>

					// field status in real time
					/* <div class="mt-8 rounded-lg border border-zinc-200 bg-white p-5">
						<div class="flex items-center justify-between">
							<div>
								<h3 class="text-sm font-semibold text-zinc-900">
									Form state
								</h3>

								<p class="mt-1 text-xs text-zinc-500">
									Current values and validation status
								</p>
							</div>
						</div>

						<div class="mt-5 divide-y divide-zinc-100 border-t border-zinc-100">

							<div class="flex items-center justify-between py-3">
								<span class="text-sm text-zinc-500">
									Submitted
								</span>

								<span
									class="max-w-[220px] truncate text-sm font-medium text-zinc-900"
									data-text="$submitted"
								></span>
							</div>

							<div class="flex items-center justify-between py-3">
								<span class="text-sm text-zinc-500">
									Email
								</span>

								<span
									class="max-w-[220px] truncate text-sm font-medium text-zinc-900"
									data-text="$email"
								></span>
							</div>

							<div class="flex items-center justify-between py-3">
								<span class="text-sm text-zinc-500">
									Password
								</span>

								<span class="text-sm font-medium text-zinc-900">
									<span data-text="$password"></span>
								</span>
							</div>

							<div class="flex items-center justify-between py-3">
								<span class="text-sm text-zinc-500">
									Confirm password
								</span>

								<span class="text-sm font-medium text-zinc-900">
									<span data-text="$confirm_password"></span>
								</span>
							</div>

						</div>

						<div class="mt-4 border-t border-zinc-100 pt-4">
							<div class="flex items-center justify-between">
								<span class="text-sm font-medium text-zinc-700">
									Form is valid ?
								</span>

								<span
									class="text-sm font-semibold text-zinc-900"
									data-text="validationController.isFormValidSignUp(
										$email,
										$password,
										$confirm_password
									)"
								></span>
							</div>
						</div>
					</div> */
				</form>
			</div>
		</div>
	</section>

	
	
}
	