meta {
  name: Verify email
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/verify-email
  body: json
  auth: inherit
}

body:json {
  {
    "otp_id":"6a8240173ad31360f7f6b083",
    "otp_code": "703816",
    "user_id": "6a823ec03ad31360f7f6b07f"
  }
}

script:post-response {
  // Parse the response body
  const jsonResponse = res.getBody();
  
  // Save access token only if it exists
  const accessToken = jsonResponse?.session?.access_token;
  
  if (accessToken) {
    bru.setEnvVar('access_token', accessToken);
    console.log('Access token saved successfully');
  }
  
  // Optional: Save other user data if available
  if (jsonResponse?.user?.id) {
    bru.setEnvVar('user_id', jsonResponse.user.id);
  }
  
  if (jsonResponse?.user?.email) {
    bru.setEnvVar('user_email', jsonResponse.user.email);
  }
  
  // Optional: Save token expiration if available
  if (jsonResponse?.session?.expires_at) {
    bru.setEnvVar('token_expires_at', jsonResponse.session.expires_at);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
