settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}

docs {
  - Simple request
  
  ```json
  {
    "name": "hobbie",
    "plan_items": [
      {
        "features": [
          "feature one",
          "feature two",
          "feature tree"
        ]
      }
    ]
  }
  ```
  
  - product with variations 
    { "name": "plane 1", "desc": null, "plan_items": \[ { "features": \[ "feature one" \], "var_option_ids": \[ "6aab24661ff8d3213b397e62", "6aab24851ff8d3213b397e65" \] }, { "features": \[ "feature two" \], "var_option_ids": \[ "6aab24691ff8d3213b397e63", "6aab24851ff8d3213b397e65" \] }, { "features": \[ "feature tree" \], "var_option_ids": \[ "6aab24701ff8d3213b397e64", "6aab24851ff8d3213b397e65" \] }, { "features": \[ "feature 1" \], "var_option_ids": \[ "6aab24661ff8d3213b397e62", "6aab248b1ff8d3213b397e66" \] }, { "features": \[ "feature 2" \], "var_option_ids": \[ "6aab24691ff8d3213b397e63", "6aab248b1ff8d3213b397e66" \] }, { "features": \[ "feature 3" \], "var_option_ids": \[ "6aab24701ff8d3213b397e64", "6aab248b1ff8d3213b397e66" \] } \] }
    
    
  
}

