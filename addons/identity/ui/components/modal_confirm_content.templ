package components

templ ModalConfirmContent(
	title string,
	description string,
	confirmText string,
	cancelText string,
	confirmColor string,
	loadingMessage string,
	confirmAction string,
	cancelAction string,
) {
	<div class="w-full max-w-md box-border p-7 bg-white rounded-xl shadow-[0_20px_50px_rgba(0,0,0,0.25)]">
		<h2 class="m-0 mb-2.5 text-xl font-semibold text-gray-900">
			{ title }
		</h2>

		<p class="m-0 mb-6 text-sm leading-relaxed text-gray-500">
			{ description }
		</p>

		<div
			data-show="$error != ''"
			style="display: none;"
			class="mb-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
		>
			<span data-text="$error"></span>
		</div>

		<div class="flex justify-end gap-3">
			<button
				type="button"
				class="px-5 py-2.5 rounded-lg text-sm font-medium border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 hover:border-gray-400 transition-all"
				data-attr:disabled="$is_loading"
				data-on:click={ cancelAction }
			>
				{ cancelText }
			</button>

			<button
				type="button"
				class={
					"rounded-lg px-5 py-2.5 text-sm font-medium text-white disabled:cursor-not-allowed disabled:opacity-50 " +
					confirmColor
				}
				data-attr:disabled="$is_loading"
				data-on:click={ confirmAction }
			>
				<span
					data-show="$is_loading"
					style="display: none;"
					class="flex items-center gap-2"
				>
					<span class="h-4 w-4 animate-spin rounded-full border-2 border-white border-t-transparent"></span>
					<span>{ loadingMessage }</span>
				</span>

				<span
					data-show="!$is_loading"
				>
					{ confirmText }
				</span>
			</button>

		</div>
	</div>
}