package components

templ DeletePaddlePlanModal() {
	@Modal("catalog-delete-paddle-plan-modal", "$modal.domain == 'paddle-plan' && $modal.action == 'delete'") {
		@ConfirmContent(
			"Delete Paddle plan",
			"Are you sure you want to delete this plan? This action cannot be undone.",
			"Delete",
			"Cancel",
			"bg-black",
			"Deleting...",
			`$error = ''; $is_loading = true; @delete('/v1/catalog/paddle-plans/' + $plan_form.id);`,
			`$modal.domain = ''; $modal.action = ''; $plan_form.id = ''; $error = ''; $is_loading = false;`,
		)
	}
}
