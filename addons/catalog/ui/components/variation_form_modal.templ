
package components

templ VariationFormModal() {
	@Modal("catalog-variation-form-modal", "$modal.domain == 'variation' && $modal.action == 'form'") {
		<div class="w-full max-w-md mx-auto rounded-xl bg-white p-7 shadow-[0_20px_50px_rgba(0,0,0,0.25)]">

			<h2 class="mb-2 text-[22px] font-semibold text-zinc-900">
				<span data-show="$variation_form.id == ''">Create variation</span>
				<span data-show="$variation_form.id != ''" style="display:none">Edit variation</span>
			</h2>

			<p class="mb-6 text-sm text-zinc-500">
				Define a variation that can be used by your catalog plans.
			</p>

			<div class="mb-5">
				<label class="mb-1.5 block text-sm font-medium text-zinc-700">
					Name
				</label>

				<input
					type="text"
					class="block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-sm text-zinc-900 outline-none placeholder:text-zinc-400 focus:border-black focus:ring-1 focus:ring-black"
					data-bind:variation_form.name
					placeholder="e.g. Billing Cycle"
					data-attr:disabled="$is_loading"
				/>
			</div>

			<div
				data-show="$error != ''"
				style="display:none"
				class="mb-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
			>
				<span data-text="$error"></span>
			</div>

			<div class="flex justify-end gap-2.5">
				<button
					type="button"
					class="rounded-lg border border-zinc-300 bg-white px-4 py-2.5 text-sm font-medium text-zinc-900 transition-colors hover:border-black hover:bg-zinc-50"
					data-attr:disabled="$is_loading"
					data-on:click="$modal.domain = ''; $modal.action = ''; $variation_form.id = ''; $variation_form.name = ''; $error = '';"
				>
					Cancel
				</button>

				<button
					type="button"
					class="rounded-lg bg-black px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-zinc-800"
					data-attr:disabled="$is_loading || $variation_form.name.trim() == ''"
					data-on:click="$error = ''; $is_loading = true; $variation_form.id == '' ? @post('/v1/catalog/variations') : @put('/v1/catalog/variations/' + $variation_form.id)"
				>
					<span data-show="$is_loading" style="display:none">
						Saving...
					</span>
					<span data-show="!$is_loading && $variation_form.id == ''">
						Create
					</span>
					<span data-show="!$is_loading && $variation_form.id != ''" style="display:none">
						Update
					</span>
				</button>
			</div>

		</div>
	}
}
