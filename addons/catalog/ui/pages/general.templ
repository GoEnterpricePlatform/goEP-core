package pages

templ CatalogGeneralContent() {
	<section>
		<div class="mb-6">
			<h1 class="text-2xl font-bold tracking-tight text-black">Catalog</h1>
			<p class="mt-1 text-sm text-zinc-500">Manage product variations and plans.</p>
		</div>
		<div class="grid grid-cols-1 gap-5 md:grid-cols-2">
			<a href="/v1/catalog/variations" class="rounded-xl border border-zinc-200 bg-white p-5 transition-colors hover:border-zinc-400">
				<p class="text-sm text-zinc-500">Catalog section</p>
				<h2 class="mt-2 text-lg font-semibold">Variations</h2>
				<p class="mt-1 text-sm text-zinc-500">Manage variation names and their options.</p>
			</a>
		</div>
	</section>
}

templ CatalogPlaceholderContent(title string) {
	<section>
		<div class="mb-6">
			<h1 class="text-2xl font-bold tracking-tight text-black">{ title }</h1>
			<p class="mt-1 text-sm text-zinc-500">This Catalog section is ready to be configured.</p>
		</div>
	</section>
}
