package pages

import "github.com/GoEnterpricePlatform/goEP-core/addons/web-app/resources"

templ BillingContent(pageTitle string) {
	<section>
		<div class="mb-6">
			<h1 class="text-2xl font-bold tracking-tight text-black">{ pageTitle }</h1>
			<p class="mt-1 text-sm text-zinc-500">Your dashboard module is ready.</p>
		</div>
		if "dashboard" == "dashboard" {
			<div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">
				<div class="rounded-xl border border-zinc-200 bg-white p-5"><p class="text-sm text-zinc-500">Overview</p><p class="mt-2 text-2xl font-bold">Ready</p></div>
				<div class="rounded-xl border border-zinc-200 bg-white p-5"><p class="text-sm text-zinc-500">Module</p><p class="mt-2 text-2xl font-bold">Billing</p></div>
			</div>
		}
	</section>
}

templ BillingPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Billing</title>
			<link href={ resources.StaticPath("css/app.css") } rel="stylesheet" type="text/css"/>
		</head>
		<body class="min-h-screen bg-white text-zinc-900 antialiased">
			<main class="mx-auto max-w-7xl px-6 py-10 lg:px-8">
				@BillingContent("Billing")
			</main>
		</body>
	</html>
}
