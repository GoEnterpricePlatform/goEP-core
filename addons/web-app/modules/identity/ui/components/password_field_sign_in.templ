package components

templ PasswordFieldSignIn() {
    <div>
		<label for="password" class="block text-sm font-medium text-zinc-700">
			Password
		</label>
		<input
			id="password"
			name="password"
			type="password"
			data-bind:password
			class="mt-1 block w-full rounded-lg border border-zinc-300 px-4 py-2.5 text-sm outline-none transition-colors"
			data-attr:class="
				`mt-1 block w-full rounded-lg border px-4 py-2.5 text-sm outline-none transition-colors ${
					$submitted
						? ($password != ''
							? 'border-green-500'
							: 'border-red-500')
						: 'border-zinc-300'
				}`
			"
		/>
		<div
			class="hidden mt-1 text-sm text-red-500"
			data-style:display="$submitted && !validationController.isValidPassword($password) ? 'block' : 'none'"
		>
			<span
				data-style:display="$password == '' ? 'inline' : 'none'"
			>
				Password is required
			</span>
		</div>
	</div>
}