// addons/web-app/ui/layouts/dashboard.templ

package layouts

import (
	"github.com/GoEnterpricePlatform/goEP-core/addons/web-app/src/ui/components"
	"github.com/GoEnterpricePlatform/goEP-core/internal/modules/navigation"
)

templ DashboardLayout(
	activePage string,
	roles []string,
	permissions []string,
	menu []navigation.Item,
	content templ.Component,
) {
	@BaseLayout(
		activePage,
		DashboardLayoutContent(activePage, roles, permissions, menu, content),
	)
}

templ DashboardLayoutContent(
	activePage string,
	roles []string,
	permissions []string,
	menu []navigation.Item,
	content templ.Component,
) {
	<div class="flex min-h-screen">

		@components.Sidebar(activePage, roles, permissions, menu)

		<div class="flex min-w-0 flex-1 flex-col">

			@components.DashboardHeader()

			<main class="flex-1 p-4">
				@content
			</main>

		</div>

	</div>
}
