package pages

import "github.com/GoEnterpricePlatform/goEP-core/addons/web-app/src/ui/layouts"

templ ModulePage(name string, summary string) {
	@layouts.BaseLayout(name, ModuleContent(name, summary))
}

templ ModuleContent(name string, summary string) {
	<div class="min-h-screen bg-white">
		<header class="border-b border-zinc-200">
			<div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-8">
				<a href="/v1/goep-admin/modules" class="text-sm font-bold tracking-[0.2em] text-black">GOEP CORE</a>
				<a href="/v1/goep-admin/modules" class="text-sm text-zinc-500 hover:text-black">Modules</a>
			</div>
		</header>
		<main class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-zinc-500">Module</p>
			<h1 class="mt-2 text-3xl font-semibold tracking-tight text-black">{ name }</h1>
			<p class="mt-3 max-w-2xl text-sm leading-6 text-zinc-600">{ summary }</p>
		</main>
	</div>
}
