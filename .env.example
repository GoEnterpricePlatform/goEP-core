MONGO_DB_URI=mongodb://localhost:27017/goep-core?directConnection=true

JWT_ACCESS_TOKEN=secret-1
JWT_REFRESH_TOKEN=secret-2
JWT_ISS=domain.com

APP_NAME=goep_core

GMAIL_USERNAME=
GMAIL_PASS=

