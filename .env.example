## Paddle
# When enabled, PADDLE_API_KEY and PADDLE_WEBHOOK_SECRET_KEY are required.
# PADDLE_ENVIRONMENT is optional and defaults to sandbox.
# IS_ENABLE_MOR_PADDLE=true
# PADDLE_API_KEY=
# PADDLE_ENVIRONMENT=sandbox
# PADDLE_WEBHOOK_SECRET_KEY=

# HTTP_SERVER_PORT=8001

# * Only for development — variables for docker-compose.dev and development tools
# * Mongo (docker-compose.dev.yml)
# For local development we will not use username or password for simplicity
# MONGO_INITDB_ROOT_USERNAME=user
# MONGO_INITDB_ROOT_PASSWORD=password
MONGO_PORT=27017

# * Minio (docker-compose.dev.yml) 
MINIO_ROOT_USER=user
MINIO_ROOT_PASSWORD=123456()Secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
